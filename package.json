{
  "name": "cinebooth",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@cinebooth/api",
    "build:api": "npm run build --workspace=@cinebooth/api",
    "typecheck:api": "npm run typecheck --workspace=@cinebooth/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  }
}